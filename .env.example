# Public values. These are embedded in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_example

# Server-only. Never prefix these with NEXT_PUBLIC_.
# Keep the existing AES key unchanged while encrypted v1 refresh tokens exist.
TOKEN_ENCRYPTION_KEY=replace-with-existing-key-in-untracked-local-env-only
TOKEN_KEY_VERSION=1

# Phase 1 background Calendar sync.
# Prefer the modern Supabase secret key when available; service-role is a fallback.
SUPABASE_SECRET_KEY=sb_secret_example
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-key-only-if-needed

# Same Google Web OAuth client configured in the Supabase Google provider.
# Required server-side to exchange the stored Google provider refresh token for
# short-lived access tokens during background Calendar synchronization.
GOOGLE_OAUTH_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-in-untracked-local-env-only

# Random high-entropy server-only value used by Vercel Cron Authorization.
CRON_SECRET=replace-in-untracked-local-env-only

# Gemini-based auto preparation for FS_AUTO_PREPARATION-flagged users only.
# Without this, the manual ChatGPT paste flow at /fs/meetings/[id] keeps
# working; Calendar sync itself never depends on Gemini being configured.
GEMINI_API_KEY=replace-in-untracked-local-env-only

# Stage-specific models, not one shared model (gemini-2.5-flash and
# gemini-2.5-flash-lite were both retired for new users - confirmed live via
# real 404s). STEP A (Research) needs Google Search grounding, which on the
# free tier is only available on specific models; STEP B/C (Preparation/
# Material) don't use grounding and can use the current GA stable model for
# output quality. If unset, code defaults apply (gemini-3.5-flash-lite /
# gemini-3.8-flash respectively).
# GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
# GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Legacy fallback, checked only if the stage-specific vars above are unset.
# GEMINI_MODEL=

# Generation-stage-only model fallback used once a job has failed enough
# times in a row (see GENERATION_FALLBACK_AFTER_ATTEMPTS in
# lib/security/server-secrets.ts) - engages for persistent 503 "high
# demand"/capacity failures, not configuration errors (those fail fast
# instead of retrying). If unset, defaults to gemini-3.5-flash-lite.
# GEMINI_GENERATION_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: enables agent_runs.estimated_cost_usd. Left unset, cost is
# always stored as NULL (never guessed/faked as 0) - set these only with
# real, current Gemini pricing for your tier.
# GEMINI_PRICE_INPUT_PER_MILLION_TOKENS_USD=
# GEMINI_PRICE_OUTPUT_PER_MILLION_TOKENS_USD=
# GEMINI_PRICE_SEARCH_PER_CALL_USD=
