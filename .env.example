# Public values. These are embedded in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_example

# Local development only. Vercel Preview/Production use server-only environment variables.
# Encode 32 random bytes as standard Base64 or Base64URL. Never change the
# existing key while google_connections contains encrypted v1 tokens.
TOKEN_ENCRYPTION_KEY=replace-with-existing-key-in-untracked-local-env-only
TOKEN_KEY_VERSION=1
# Google OAuth client credentials belong to the Supabase Google provider,
# not Vercel. No Supabase service-role key is used by the Phase 0 app.
